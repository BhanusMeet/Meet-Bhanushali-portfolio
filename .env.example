# ── Public (bundled into the browser build) ─────────────────────────────────
# Safe to expose: the anon / publishable key is designed to be public and is
# constrained by Row Level Security. NEVER put a service-role / secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=        # legacy "anon" JWT key or new "sb_publishable_..." key

# Contact channels. Leave blank to hide a channel in production.
VITE_CONTACT_EMAIL=
VITE_INSTAGRAM_URL=
VITE_LINKEDIN_URL=
VITE_FIVERR_URL=

# ── Server-side only (Supabase Edge Function secrets - NOT read by Vite) ────
# Set with:  supabase secrets set --env-file supabase/.env.local
# Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY
# into Edge Functions automatically; you only need to set the custom ones below.
PUBLIC_SITE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_SALT=               # long random string, used to hash client IPs
